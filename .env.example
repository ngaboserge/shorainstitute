# ── Supabase (frontend) ─────────────────────────────────────────────────────
# Get these values from your Supabase dashboard: Settings > API
VITE_SUPABASE_URL=your_supabase_project_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Supabase (payment API server — never expose in frontend) ────────────────
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ── Site (card return URL + webhook base) ───────────────────────────────────
# Used by the payment API to build XentriPay card return URLs:
#   {base}/payment/success?ref={referenceId}&payment=return
#
# Local:  http://localhost:3000  (browser redirect works on your machine)
# Prod:   https://www.shorainstitute.com
SITE_URL=http://localhost:3000
VITE_SITE_URL=http://localhost:3000
# Optional override for card return only (tutor-space pattern).
# Use when SITE_URL is localhost but you want returns on the public domain.
# XENTRIPAY_CARD_RETURN_URL_BASE=https://www.shorainstitute.com

# ── XentriPay v2 ─────────────────────────────────────────────────────────────
# Keys: https://xentripay.com/settings/api-keys (sandbox: merchant.test.xentripay.com)
XENTRIPAY_API_KEY=your_xentripay_api_key_here
# Production:
XENTRIPAY_SANDBOX=false
XENTRIPAY_BASE_URL=https://xentripay.com
# Sandbox (local testing):
# XENTRIPAY_SANDBOX=true
# XENTRIPAY_BASE_URL=https://test.xentripay.com
XENTRIPAY_CHARGES_INCLUDED=true
# Dashboard webhooks are URL-only; leave empty unless XentriPay sends a secret header.
# XENTRIPAY_WEBHOOK_SECRET=

# ── Pricing (XentriPay collects RWF only; used to convert USD/EUR prices) ───
USD_TO_RWF_RATE=1463.5
EUR_TO_RWF_RATE=1590

# ── Frontend feature flags ───────────────────────────────────────────────────
# Card payments require activation in the XentriPay merchant dashboard.
VITE_CARD_PAYMENT_ENABLED=false

# ── Email Notifications ──────────────────────────────────────────────────────
# cPanel SMTP settings for sending enrollment notification emails
# Use your existing cPanel email account (e.g., info@shorainstitute.com)

# SMTP server (usually mail.yourdomain.com for cPanel)
SMTP_HOST=mail.shorainstitute.com

# SMTP port: 465 (SSL) or 587 (TLS) - most cPanel servers use 465
SMTP_PORT=465

# Your cPanel email address
SMTP_USER=info@shorainstitute.com

# Your cPanel email password
SMTP_PASS=your_email_password_here

# Secret token for email cron job authentication
EMAIL_CRON_SECRET=your_random_secret_token_here

# IMPORTANT:
# 1. Copy this file to .env (don't commit .env to git!)
# 2. Replace the placeholder values with your actual credentials
# 3. Restart both dev servers after changes: npm run dev + npm run dev:api
